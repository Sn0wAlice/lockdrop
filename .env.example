# Server
PORT=3000
NODE_ENV=production
SESSION_SECRET=          # openssl rand -hex 32

# Admin credentials
ADMIN_USER=admin
ADMIN_PASSWORD=          # choose a strong password

# Database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=lockdrop
DB_USER=lockdrop
DB_PASSWORD=             # choose a strong password

# Upload
MAX_FILE_SIZE_MB=500
UPLOAD_DIR=./uploads

# App URL (used for share links — set to your public domain)
APP_URL=https://lockdrop.yourdomain.com
